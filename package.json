{
    "name": "smb-platform",
    "version": "0.1.0",
    "description": "Multi-tenant configurable platform for photo studios, plumbers, and electrical contractors",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
          "dev": "node --watch src/index.js",
          "start": "node src/index.js",
          "build": "tsc",
          "test": "jest",
          "test:integration": "jest --testPathPattern=integration",
          "test:coverage": "jest --coverage",
          "lint": "eslint src",
          "format": "prettier --write src",
          "migrate": "node src/database/migrations.js",
          "seed": "node src/database/seed.js"
    },
    "keywords": [
          "multi-tenant",
          "SMB",
          "photography",
          "plumbing",
          "electrical",
          "project-management",
          "time-tracking",
          "equipment-management"
    ],
    "author": "SMB Platform Team",
    "license": "MIT",
    "dependencies": {
          "express": "^4.18.2",
          "sequelize": "^6.35.2",
          "pg": "^8.11.3",
          "pg-hstore": "^2.3.4",
          "jsonwebtoken": "^9.1.2",
          "bcryptjs": "^2.4.3",
          "dotenv": "^16.3.1",
          "cors": "^2.8.5",
          "helmet": "^7.1.0",
          "express-validator": "^7.0.0",
          "aws-sdk": "^2.1566.0",
          "multer": "^1.4.5-lts.1",
          "nodemailer": "^6.9.7",
          "uuid": "^9.0.1",
          "axios": "^1.6.5"
    },
    "devDependencies": {
          "@types/express": "^4.17.21",
          "@types/node": "^20.10.5",
          "typescript": "^5.3.3",
          "eslint": "^8.56.0",
          "@typescript-eslint/eslint-plugin": "^6.16.0",
          "@typescript-eslint/parser": "^6.16.0",
          "prettier": "^3.1.1",
          "jest": "^29.7.0",
          "ts-jest": "^29.1.1",
          "supertest": "^6.3.3"
    },
    "engines": {
          "node": ">=18.0.0",
          "npm": ">=9.0.0"
    }
}
